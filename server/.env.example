# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# URL of the frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Option 1: full connection string (takes precedence)
DATABASE_URL=

# Option 2: individual fields
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cliniqueci_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Test database
TEST_DATABASE_URL=
TEST_DB_NAME=cliniqueci_test

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret

# ── AI Assistant (Awa) ────────────────────────────────────────────────────────
# Optional — leave empty to use demo fallback responses
ANTHROPIC_API_KEY=

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Mode : "simulation" (défaut dev) ou "live" (production)
WHATSAPP_MODE=simulation

# Token d'accès permanent obtenu sur Meta for Developers
# https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_TOKEN=

# ID du numéro de téléphone expéditeur (Phone Number ID sur Meta)
WHATSAPP_PHONE_ID=

# Token de vérification webhook (chaîne aléatoire que vous choisissez)
# Configure le même dans Meta → WhatsApp → Configuration → Webhook Verify Token
WHATSAPP_VERIFY_TOKEN=mon_token_webhook_secret

# ── Templates WhatsApp à enregistrer sur Meta (langue: fr) ───────────────────
# rdv_confirmation : {{1}}=prénom  {{2}}=date  {{3}}=heure  {{4}}=Dr X  {{5}}=Clinique
# rdv_rappel_j1   : {{1}}=prénom  {{2}}=date  {{3}}=heure  {{4}}=Dr X
# rdv_rappel_h2   : {{1}}=prénom  {{2}}=heure
# rdv_annule      : {{1}}=prénom  {{2}}=date  {{3}}=heure
